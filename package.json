{
  "name": "project-nova",
  "version": "1.0.0",
  "description": "Lightweight minimalist European-style e-commerce and landing page builder with dedicated admin dashboard.",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
