# =========================================================
# Nova — environment configuration
# =========================================================

# HTTP port for the Backend API + static server
PORT=3200

# PostgreSQL connection string.
# Leave empty (or comment out) to use the built-in JSON-file
# backend (current data/ folder). To use PostgreSQL / Supabase,
# point DATABASE_URL at your database and run:
#   npm run db:migrate
#   npm run db:seed
#
# Examples:
#   Supabase / local Postgres / Neon / RDS / VPS:
# DATABASE_URL=
#   DATABASE_URL=postgres://user:password@localhost:5432/nova
#   DATABASE_URL=postgresql://<user>:<password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require

# Optional: force the JSON-file backend even if DATABASE_URL is set
# DB_FORCE_JSON=1

# Optional: PostgreSQL pool size (default 10)
# DB_POOL_MAX=10